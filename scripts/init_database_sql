/*
=================================================
Create Database and Schemas
=================================================
Purpose: This script creates a new database named 'DataWarehouse' after checking if it already exists. 
If it does, it will be dropped and recreated. Additionally, the script sets up three schemas within it:'bronze','silver' and 'gold'.

WARNING:
      Running this script WILL DROP the entire database if it exists. All data will be deleted permanently, hence
      proceed with caution and ensure you have backups.
*/

USE master;
GO

--Drop and recreate the 'DataWarehouse' database
IF EXISTS(SELECT 1 FROM sys.databases WHERE name = 'DataWarehouse')
BEGIN
    ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE DataWarehouse;
END;
GO
-- Create the 'DataWarehouse' database
CREATE DATABASE DataWarehouse;

USE DataWarehouse;
GO

--Create Schemas
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver
GO
CREATE SCHEMA gold;
GO
